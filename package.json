{
  "name": "ria-stac",
  "version": "0.1.0",
  "description": "STAC client for web map applications: STAC APIs and static catalogs, collection filters, item search and picking with CQL2, credentials sent only to the origins they belong to",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p demo/tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "publint",
    "verify": "npm run typecheck && npm test && npm run build && npm run lint",
    "prepublishOnly": "npm run verify",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none --treatValidationWarningsAsErrors",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "keywords": [
    "stac",
    "stac-api",
    "spatiotemporal-asset-catalog",
    "cql2",
    "luciadria",
    "luciad",
    "remote-sensing",
    "earth-observation"
  ],
  "author": "felipecarrillo100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/ria-stac.git"
  },
  "bugs": {
    "url": "https://github.com/felipecarrillo100/ria-stac/issues"
  },
  "homepage": "https://github.com/felipecarrillo100/ria-stac#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ogc-cql2": "^1.7.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@luciad/ria": "^2026.1.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dayjs": "^1.11.23",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typedoc": "^0.28.20",
    "typescript": "~5.7.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
